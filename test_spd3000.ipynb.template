   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RUN_CH3_OUTPUT_TEST = False\n",
    "CH3_ON_SECONDS = 1.0\n",
    "if not RUN_CH3_OUTPUT_TEST:\n",
    "    print(\"Skipped; set RUN_CH3_OUTPUT_TEST = True after preparing CH3 safely\")\n",
    "elif input(\"Type 'ENERGIZE CH3' to proceed: \").strip() != \"ENERGIZE CH3\":\n",
    "    print(\"Cancelled before sending any CH3 command.\")\n",
    "else:\n",
    "    try:\n",
    "        psu.output(spd.Channel.CH3, spd.OutputState.ON)\n",
    "        sleep(CH3_ON_SECONDS)\n",
    "        print(\"Confirm the CH3 front-panel indication and physical voltage now.\")\n",
    "    finally:\n",
    "        psu.output(spd.Channel.CH3, spd.OutputState.OFF)\n",
    "        print(\"Sent CH3 OFF.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Optional timer and waveform configuration round trip\n",
    "\n",
    "This test is available only on SPD3303X/X-E, overwrites one timer group and toggles one waveform-display state after confirmation, verifies both, and restores their original values in `finally`.\n",
    "It deliberately does not start the timer or energize an output."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "RUN_TIMER_WAVEFORM_TEST = False\n",
    "TIMER_CHANNEL = spd.Channel.CH1\n",
    "TIMER_GROUP = 5\n",
    "TIMER_STEP = {\"voltage_v\": 1.0, \"current_a\": 0.1, \"duration_s\": 1.0}\n",
    "if not psu.capabilities.timer:\n",
    "    print(f\"Timer commands are not supported by {psu.model.value}\")\n",
    "elif not RUN_TIMER_WAVEFORM_TEST:\n",
    "    print(\"Skipped; set RUN_TIMER_WAVEFORM_TEST = True to prepare this test\")\n",
    "else:\n",
    "    original_timer_step = psu.timer.set(TIMER_CHANNEL, TIMER_GROUP)\n",
    "    timer_status = psu.system.status\n",
    "    channel_status = timer_status.ch1 if TIMER_CHANNEL is spd.Channel.CH1 else timer_status.ch2\n",
    "    original_waveform = channel_status.waveform\n",
    "    pprint(\n",
    "        {\n",
    "            \"current_timer_step\": original_timer_step,\n",
    "            \"planned_timer_step\": TIMER_STEP,\n",
    "            \"current_waveform_display\": original_waveform,\n",
    "        },\n",
    "        sort_dicts=False,\n",
    "    )\n",
    "    phrase = f\"OVERWRITE TIMER {TIMER_CHANNEL.value} {TIMER_GROUP}\"\n",
    "    if input(f\"Type {phrase!r} to proceed: \").strip() != phrase:\n",
    "        print(\"Cancelled before writing the timer group.\")\n",
    "    else:\n",
    "        try:\n",
    "            with psu.batch(), psu.verify_writes():\n",
    "                psu.timer.set(TIMER_CHANNEL, TIMER_GROUP, **TIMER_STEP)\n",
    "                if original_waveform is not None:\n",
    "                    changed_waveform = not original_waveform\n",
    "                    psu.output.wave(\n",
    "                        TIMER_CHANNEL,\n",
    "                        spd.WaveformState.ON if changed_waveform else spd.WaveformState.OFF,\n",
    "                    )\n",
    "            print(\"Timer and waveform configuration round trip passed.\")\n",
    "        finally:\n",
    "            with psu.batch():\n",
    "                if original_waveform is not None:\n",
    "                    psu.output.wave(\n",
    "                        TIMER_CHANNEL,\n",
    "                        spd.WaveformState.ON if original_waveform else spd.WaveformState.OFF,\n",
    "                    )\n",
    "                psu.timer.set(TIMER_CHANNEL, TIMER_GROUP, **original_timer_step)\n",
    "            print(\"Restored the original timer group and waveform-display state.\")"
   ]
