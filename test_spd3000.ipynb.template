   "source": [
    "### 1.2 Connection through the gateway\n",
    "\n",
    "Use this cell instead of the general connection cell when a gateway server owns the physical instrument connection.\n",
    "Close any direct `psu` connection to the same supply before starting the gateway, then start the server in a separate terminal:\n",
    "\n",
    "```bash\n",
    "spd3000 gateway serve\n",
    "```\n",
    "\n",
    "After the server reports that it is listening, run the code cell below.\n",
    "Use `localhost` when the gateway runs on this computer, or replace it with the gateway computer's hostname or `host[:port]`.\n",
    "The token loader returns `None` when `gateway-auth.toml` is absent or has no non-empty `token` field, so the same cell works whether authentication is enabled or disabled."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "gateway-connection"
    ]
   },
   "outputs": [],
   "source": [
    "from __future__ import annotations\n",
    "import atexit\n",
    "import siglent_spd3000 as spd\n",
    "\n",
    "if \"psu\" in globals():\n",
    "    psu.close()\n",
    "\n",
    "psu = spd.SPD3000.connect(\n",
    "    connection=spd.ConnectionType.GATEWAY,\n",
    "    identifier=\"localhost\",  # gateway hostname or host[:port]\n",
    "    timeout_s=5.0,\n",
    "    min_command_interval_ms=100.0,\n",
    "    verify_writes_globally=False,\n",
    "    token=spd.load_gateway_auth(\"gateway-auth.toml\"),\n",
    ")\n",
    "atexit.register(psu.close)\n",
    "print(psu)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### 1.2.1 Multi-client read test\n",
    "\n",
    "This read-only test opens two additional gateway clients and releases them together so both submit CH1 measurement batches at nearly the same time.\n",
    "It reuses the gateway endpoint and execution settings from the active `psu` created in section 1.2.\n",
    "Each client sends voltage and current queries as one batch; the gateway console should show two client addresses and two complete, non-interleaved batches.\n",
    "The batches may complete in either order, but this cell does not change any power-supply setting or output state."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "gateway-multi-client"
    ]
   },
   "outputs": [],
   "source": [
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from threading import Barrier\n",
    "\n",
    "assert psu.connection_type is spd.ConnectionType.GATEWAY\n",
    "assert psu.connection_identifier is not None\n",
    "gateway_token = spd.load_gateway_auth(\"gateway-auth.toml\")\n",
    "\n",
    "start_barrier = Barrier(2)\n",
    "\n",
    "\n",
    "def read_ch1_from_gateway(client_number: int) -> tuple[int, float, float]:\n",
    "    with spd.SPD3000.connect(\n",
    "        connection=spd.ConnectionType.GATEWAY,\n",
    "        identifier=psu.connection_identifier,\n",
    "        timeout_s=psu.settings.timeout,\n",
    "        min_command_interval_ms=psu.settings.min_command_interval * 1000.0,\n",
    "        token=gateway_token,\n",
    "    ) as client:\n",
    "        start_barrier.wait(timeout=10.0)\n",
    "        with client.batch() as responses:\n",
    "            client.measure.voltage(spd.Channel.CH1)\n",
    "            client.measure.current(spd.Channel.CH1)\n",
    "    voltage_v, current_a = responses\n",
    "    return client_number, voltage_v, current_a\n",
    "\n",
    "\n",
    "with ThreadPoolExecutor(max_workers=2) as pool:\n",
    "    futures = [pool.submit(read_ch1_from_gateway, number) for number in (1, 2)]\n",
    "    for future in as_completed(futures):\n",
    "        client_number, voltage_v, current_a = future.result()\n",
    "        print(f\"Client {client_number}: CH1 = {voltage_v} V, {current_a} A\")"
   ]
  },
